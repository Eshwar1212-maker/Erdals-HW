import random

def play_blackjack():
   
    deck = [2, 3, 4, 5, 6, 7, 8, 9, 10, 10, 10, 10, 11] * 4
    random.shuffle(deck)

    
    player_hand = [deck.pop(), deck.pop()]
    dealer_hand = [deck.pop(), deck.pop()]

    print(f"Your cards: {player_hand} → Total: {sum(player_hand)}")
    print(f"Dealer shows: [{dealer_hand[0]}]")

    
    player_busted = False
    while True:
        action = input("Hit or stand ").strip().lower()
        if action == "hit":
            new_card = deck.pop()
            player_hand.append(new_card)
            player_total = sum(player_hand)
            print(f"You drew a {new_card} → Total: {player_total}")
            
            if player_total > 21:
                print("You lose")
                player_busted = True
                break
        elif action == "stand":
            break
        else:
            print("Please type 'hit' or 'stand'")

   
    if not player_busted:
        print(f"Dealer reveals: {dealer_hand} → Total: {sum(dealer_hand)}")
        
        while sum(dealer_hand) < 17:
            new_card = deck.pop()
            dealer_hand.append(new_card)
            print(f"Dealer hits draws {new_card} → Total: {sum(dealer_hand)}")

        player_total = sum(player_hand)
        dealer_total = sum(dealer_hand)
        print()

        # Outcome Logic
        if dealer_total > 21:
            print("you win")
        elif player_total > dealer_total:
            print("You win")
        elif dealer_total > player_total:
            print("Dealer wins")
        else:
            print("It's a tie ")

if __name__ == "__main__":
    play_blackjack()